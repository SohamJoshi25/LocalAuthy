{
  "name": "authy",
  "version": "1.0.0",
  "description": "A Local Authenticator",
  "keywords": [
    "authenticator",
    "local"
  ],
  "license": "MIT",
  "author": "Soham Joshi",
  "type": "module",
  "main": "server.js",
  "scripts": {
  "dev": "tsx watch src/server.ts",
  "clean": "rm -rf dist",
  "typecheck": "tsc --noEmit",
  "test": "npm run typecheck && vitest --run",
  "test:coverage": "npm run typecheck && vitest --coverage",
  "build": "npm run clean && tsc",
  "verify": "npm run test && npm run build",
  "start": "npm run verify && NODE_ENV=production node dist/server.js",
  "network": "npm run verify && NODE_ENV=production HOST=0.0.0.0 node dist/server.js"
},
"dependencies": {
    "@types/multer": "^2.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "multer": "^2.3.0",
    "otplib": "^13.5.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true
  }
}
